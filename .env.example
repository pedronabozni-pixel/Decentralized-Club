# ==========================================================================
#  DECENTRALIZED CLUB - Variaveis de ambiente
#  Copie este arquivo para `.env` e preencha os valores.
#  NUNCA commite o arquivo .env (ele esta no .gitignore).
# ==========================================================================

# ---- Servidor ----
PORT=3010
NODE_ENV=development

# ---- Autenticacao (JWT) ----
# Gere um segredo forte, ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-por-um-segredo-bem-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# ---- Banco de dados ----
# Fase 1 (local): SQLite embarcado (zero instalacao). Caminho do arquivo:
SQLITE_PATH=./data/decentralized.db
#
# Fase 4 (producao / Railway): PostgreSQL. Quando migrar, defina:
# DATABASE_URL=postgres://user:pass@host:5432/decentralized

# ---- Cache ----
# Fase 1: cache em memoria (sem instalacao). TTL dos precos em segundos:
PRICE_CACHE_TTL=30
# Fase 4 (opcional): Redis -> REDIS_URL=redis://localhost:6379

# ---- APIs externas (todas opcionais; as gratuitas nao exigem chave) ----
# CoinGecko: gratis e sem chave. Binance publico: sem chave.
# Cotacao do dolar: https://economia.awesomeapi.com.br (gratis, sem chave)
# Banco Central (SELIC): https://www.bcb.gov.br/api (gratis, sem chave)

# CoinMarketCap (OPCIONAL - so se quiser usar como fonte alternativa):
# COINMARKETCAP_API_KEY=

# ---- CORS ----
# Origem permitida do frontend (deixe * em dev). Em producao use o dominio real.
CORS_ORIGIN=*
